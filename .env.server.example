# Copy to .env.server.local. This file is read by Node, not Create React App.
# Never use a REACT_APP_ prefix for an API key or a database credential.

# ---------------------------------------------------------------------------
# OpenAI Realtime (IntelliJudge)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_VOICE=alloy
REALTIME_PORT=43128
PORT=43127

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Uses the shared local MongoDB from ubc/tlef-mongodb-docker on port 27017 --
# the same instance BiocBot and GRASP use. Clone that repo and `docker compose
# up -d` if it is not already running. Moot Court just gets its own database
# name on it; nothing else is shared.
#
# Leave MONGODB_URI unset to run with no database at all: the courtroom works,
# nothing is saved.
MONGODB_URI=mongodb://mongoadmin:secret@127.0.0.1:27017/?authSource=admin
MONGODB_DB_NAME=mootcourt_dev

# Staging and production differ only in these two values — same code, same
# image. Point them at the managed instance and use a distinct database name:
#   MONGODB_DB_NAME=mootcourt_staging
#   MONGODB_DB_NAME=mootcourt_prod

# ---------------------------------------------------------------------------
# Practice materials (upload + retrieval)
# ---------------------------------------------------------------------------
# QDRANT_URL is the switch for the whole feature, the same way MONGODB_URI is
# for persistence. Leave it unset and the upload step never appears, no upload
# routes are mounted, and the judge is given no search tool — the courtroom
# behaves exactly as it did before uploads existed.
#
# Uses the shared local Qdrant from ubc/tlef-qdrant on port 6333 — the same
# instance BiocBot and GRASP use. Clone that repo and `docker compose up -d` if
# it is not already running. Moot Court gets its own collection on it.
#
# Uploads also need MONGODB_URI: the extracted text lives in MongoDB and the
# vectors in Qdrant, and with either missing the feature stays off rather than
# half-working.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=super-secret-dev-key
QDRANT_COLLECTION_NAME=mootcourt_materials

# The embedding model's dimension is baked into the collection name, because
# Qdrant cannot change a collection's vector size and vectors from different
# models are not comparable. Changing this creates a new collection; the old one
# is left alone. A model not in the built-in size table also needs
# QDRANT_VECTOR_SIZE set to its output dimension.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# QDRANT_VECTOR_SIZE=1536

# Reads charts, exhibits, diagrams and screenshots inside an uploaded PDF or
# .docx into text, so an image-heavy brief is searchable rather than invisible.
# Identical and template images are de-duplicated by the parser, so a logo on
# every page costs one call, not one per page.
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_VISION_REASONING_EFFORT=medium

# Chunking. Paragraph-aware: these are targets in characters, not hard cuts.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNK_MIN=100

# Upload limits, per practice session.
MATERIALS_MAX_FILE_BYTES=26214400
MATERIALS_MAX_FILES=5

# How many passages the judge gets back per search. Kept small deliberately:
# the result is read aloud through a voice model, so more context costs more in
# latency than it buys in quality.
MATERIALS_SEARCH_LIMIT=4
# MATERIALS_SCORE_THRESHOLD=0

# Uploaded text and its vectors are deleted from MongoDB and Qdrant together
# this many days after the brief is created. 0 keeps them indefinitely.
MATERIALS_RETENTION_DAYS=7

# Develops the upload pipeline with no OpenAI account and no network: fake
# deterministic vectors, and images are not read. Never set this in staging or
# production — real uploads would be indexed with vectors that retrieve
# nonsense. Off unless explicitly set.
# MATERIALS_STUB=1

# Prints the document parser's per-step debug output during an upload.
# MATERIALS_DEBUG=1

# ---------------------------------------------------------------------------
# CWL login
# ---------------------------------------------------------------------------
# THE PRIVACY SWITCH. Off (or unset) means: no login screen, no SAML routes
# mounted, no CWL attribute read or stored, and practice sessions saved with no
# identity attached. Deploy in this state until the PIA is approved.
#
# Turning it on requires MONGODB_URI, SESSION_SECRET, SAML_ENTRY_POINT and
# SAML_CERT_PATH — the server refuses to start otherwise rather than running
# half-configured.
SHOW_LOGIN=false

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=
SESSION_TTL_HOURS=24

# The origin the browser uses. In development the React dev server proxies
# /auth and /api to this server, so both live on http://localhost:43127.
# In production set this to the deployed URL.
# PUBLIC_URL=http://localhost:43127

# --- Local fake CWL (ubc/docker-simple-saml on port 8080) -------------------
# The service provider must be registered in that project first — see
# docs/cwl-login.md. Test accounts: bio_student / bio_student (student),
# bio_prof / bio_prof (faculty).
SAML_ISSUER=http://localhost:43127
SAML_CALLBACK_URL=http://localhost:43127/auth/saml/callback
SAML_ENTRY_POINT=http://localhost:8080/simplesaml/saml2/idp/SSOService.php
SAML_LOGOUT_URL=http://localhost:8080/simplesaml/saml2/idp/SingleLogoutService.php
SAML_METADATA_URL=http://localhost:8080/simplesaml/saml2/idp/metadata.php
SAML_CERT_PATH=/absolute/path/to/docker-simple-saml/cert/server.crt
SAML_ENVIRONMENT=STAGING
ENABLE_SLO=true

# --- Real UBC Shibboleth (staging / production) ----------------------------
# Replace the entry point, logout URL, metadata URL and certificate with the
# UBC IdP values, set SAML_ENVIRONMENT=PRODUCTION, and register the deployed
# ACS URL with UBC IAM. Nothing else changes.
# SAML_PRIVATE_KEY_PATH=/absolute/path/to/sp-private-key.pem
